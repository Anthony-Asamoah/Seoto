# Copy to .env and fill in real values. Do NOT commit .env.
# Settings are read via python-decouple; OS env vars override these.

# DJANGO
DEBUG=True
SECRET_KEY='change-me-to-a-long-random-string'
# Previous keys, comma-separated: still verify old sessions/links during a rotation.
SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
APP_DOMAIN=http://localhost:8000
# HSTS max-age (seconds) once DEBUG=False; 0 disables. Browsers cache it, so ramp up.
SECURE_HSTS_SECONDS=0

# LOGS
LOG_LEVEL=20
LOG_FORMAT='[%(asctime)s] - %(levelname)s - %(message)s'

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True
# Local development: run mailpit (`brew install mailpit && brew services start mailpit`)
# and point the four settings below at it — inbox at http://localhost:8025.
# EMAIL_PASSWORD must be empty: mailpit offers no SMTP AUTH, and Django only tries to
# log in when a password is set, which fails with SMTPNotSupportedError.
#EMAIL_HOST=127.0.0.1
#EMAIL_PORT=1025
#EMAIL_USE_TLS=False
#EMAIL_PASSWORD=

# DATABASE: sqlite | postgres
DEFAULT_DB=sqlite
# postgres (only needed when DEFAULT_DB=postgres)
PG_DB_NAME=seoto
PG_DB_USER=postgres
PG_DB_PASSWORD=postgres
PG_DB_HOST=localhost
PG_DB_PORT=5432
# Or a single URL, which wins over the PG_DB_* fields above.
#PG_DB_URL=postgres://user:pass@host:5432/db
# True when connecting through PgBouncer in transaction mode.
PG_BEHIND_PGBOUNCER=False

# Redis: Celery broker (db 0) and Django cache (db 1). Blank = in-memory broker + per-process cache.
REDIS_URL=

# Theme feature flag
IS_THEME_ENABLED=False

# Admin two-factor. Enrol devices with: python manage.py setup_admin_totp <username>
# Set to False only to recover from a lockout — enrolled devices are kept either way.
IS_ADMIN_OTP_ENABLED=True
OTP_TOTP_ISSUER=Seoto
# True hides device secrets and QR codes in the admin (blocks self-service enrolment).
OTP_ADMIN_HIDE_SENSITIVE_DATA=False

# Public API — origins allowed to read /api/ cross-origin (the marketing site).
CORS_ALLOWED_ORIGINS=https://seoto.org
IS_API_DOCS_ENABLED=False
API_PAGE_SIZE=10
API_MAX_PAGE_SIZE=60

# VAPID (web push) — generate with: python manage.py generate_vapid_keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# How long (seconds) the service worker serves cacheable pages (see sw.js
# CACHEABLE_ROUTES) straight from cache before re-fetching from the network.
CLIENT_CACHE_TTL_SECONDS=300

# Expected daily run time for `process_recurring_transactions` (hour used for drift warnings only;
# actual scheduling is done via a PythonAnywhere Scheduled Task, not this value)
RECURRING_TRANSACTIONS_CRON=0 19 * * *

# reCAPTCHA v3 (leave keys blank to skip verification in local/dev)
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# IPQUALITYSCORE
IP_QUALITY_SCORE_API_KEY=

# Weather widget — provider selection (see seoto/external_services/weather/factory.py).
# Defaults are free, no API key required.
WEATHER_PROVIDER=open_meteo
GEOLOCATION_PROVIDER=ip_api

# CALENDLY — consultation booking link
CALENDLY_URL=https://calendly.com/anthony-asamoah/30min

# SEOTO — marketing site URL
SEOTO_URL=https://seoto.org

# MEDIA STORAGE: LOCAL | AWS
MEDIA_STORAGE=LOCAL
# STATIC STORAGE: LOCAL (WhiteNoise) | AWS; defaults to MEDIA_STORAGE. Docker pins LOCAL.
#STATIC_STORAGE=LOCAL

# AWS (only needed when MEDIA_STORAGE=AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_BUCKET_PREFIX=

# Blog media upload limits in MB (optional; defaults shown)
BLOG_UPLOAD_MAX_SIZE_MB=10
BLOG_VIDEO_MAX_SIZE_MB=60

# Passkeys: optional; default to APP_DOMAIN in prod.
OTP_WEBAUTHN_RP_ID=localhost
OTP_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:8000

# DOCKER — compose builds PG_DB_URL/REDIS_URL from these.
# Local run: APP_HOST=apps.localhost, APP_ENV_FILE=.env.docker.local (this file's own name), HTTP_PORT=8080, HTTPS_PORT=8443.
#POSTGRES_DB=seoto
#POSTGRES_USER=seoto
#POSTGRES_PASSWORD=
#APP_HOST=apps.seoto.org
#ACME_EMAIL=admin@seoto.org
#APP_ENV_FILE=.env.prod
#HTTP_PORT=80
#HTTPS_PORT=443
